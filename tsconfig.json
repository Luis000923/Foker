{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["@foker/source"],
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@foker/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "scripts/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
