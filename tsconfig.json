{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "customConditions": ["@foker/source"],
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "@foker/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "vitest.config.ts",
    "benchmarks/src/**/*.ts",
    "benchmarks/**/*.test.ts"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**", "benchmarks/fixtures/fixture-a/tasks/**", "benchmarks/generated/**"]
}
