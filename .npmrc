engine-strict=true
# T12 / FKR-DEP-004: no se fija ignore-scripts=true a propósito. pnpm >= 10 ya bloquea los scripts
# de instalación de las dependencias salvo los listados en allowBuilds (pnpm-workspace.yaml, vacío),
# y los binarios de @napi-rs llegan precompilados como optionalDependencies, sin scripts.
# ignore-scripts=true desactivaría además los scripts del propio workspace. `foker check-deps`
# considera este modo equivalente y falla si aparece dangerouslyAllowAllBuilds.
