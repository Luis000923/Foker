{
  "name": "@foker/engine",
  "version": "0.1.0-beta.0",
  "description": "Foker engine: configuration, tasks, gates, validation, skills, audit, and deterministic Caveman payload compression.",
  "license": "Apache-2.0",
  "author": "Luis (@Luis000923)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luis000923/Foker.git",
    "directory": "packages/engine"
  },
  "type": "module",
  "exports": {
    ".": {
      "@foker/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node ../../scripts/copy-data.mjs skills packages/engine/skills && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@foker/core": "workspace:*",
    "@foker/policy": "workspace:*",
    "@foker/schemas": "workspace:*",
    "yaml": "2.9.1"
  }
}
