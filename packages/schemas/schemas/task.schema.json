{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foker.dev/schemas/task/v1.json",
  "title": "Foker TaskRecord",
  "description": "Registro de tarea en .foker/tasks/<task_id>.json y salida de foker_task_get (FOKER-SPEC §12). Los eventos van en <task_id>.events.jsonl (cada línea = $defs/event). La evidencia de cada intento en .foker/runs/<task_id>/<attempt>/evidence.json (= $defs/evidence).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "state",
    "description",
    "scope",
    "profile",
    "attempt",
    "max_attempts",
    "created_at",
    "updated_at",
    "created_by",
    "baseline",
    "approvals",
    "last_gates",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "$ref": "../common/v1.json#/$defs/taskId" },
    "state": { "$ref": "#/$defs/state" },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "scope": { "$ref": "#/$defs/scope" },
    "profile": { "type": "string", "minLength": 1 },
    "skill": { "type": ["string", "null"] },
    "attempt": { "description": "0 antes del primer RUNNING.", "type": "integer", "minimum": 0, "maximum": 5 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "client_token": { "type": ["string", "null"], "maxLength": 64 },
    "created_at": { "$ref": "../common/v1.json#/$defs/timestamp" },
    "updated_at": { "$ref": "../common/v1.json#/$defs/timestamp" },
    "last_activity_at": {
      "description": "Última llamada con este task_id; base del lease de 4 h.",
      "$ref": "../common/v1.json#/$defs/timestamp"
    },
    "created_by": { "$ref": "#/$defs/actor" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
    "last_gates": { "type": "array", "items": { "$ref": "../common/v1.json#/$defs/gateResult" } },
    "next_action": { "$ref": "#/$defs/nextAction" },
    "blocked_reason": { "type": ["string", "null"] }
  },
  "$defs": {
    "state": {
      "enum": [
        "PENDING",
        "PLANNED",
        "RUNNING",
        "VALIDATING",
        "REJECTED",
        "AWAITING_APPROVAL",
        "BLOCKED",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "nextAction": {
      "description": "Qué debe hacer el agente o la persona a continuación.",
      "enum": [
        "work_and_submit",
        "fix_and_resubmit",
        "await_human_approval",
        "blocked_contact_human",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "actor": {
      "description": "mcp:<clientInfo.name> | cli:<usuario> | foker (transiciones automáticas).",
      "type": "string",
      "pattern": "^(mcp:.+|cli:.+|foker)$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "../common/v1.json#/$defs/glob" }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_head", "dirty_files", "snapshot_hash"],
      "properties": {
        "git_head": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40,64}$" },
        "dirty_files": { "type": "array", "items": { "$ref": "../common/v1.json#/$defs/fileId" } },
        "snapshot_hash": {
          "description": "Hash de los hashes de archivos en alcance al empezar.",
          "$ref": "../common/v1.json#/$defs/hash"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "actor", "at"],
      "properties": {
        "action": { "enum": ["approve", "reject", "unblock"] },
        "actor": { "$ref": "#/$defs/actor" },
        "at": { "$ref": "../common/v1.json#/$defs/timestamp" },
        "reason": { "type": "string" },
        "scope": { "description": "Nuevo alcance fijado por unblock --scope.", "$ref": "#/$defs/scope" }
      }
    },
    "event": {
      "description": "Línea de <task_id>.events.jsonl. prev_hash encadena con el evento anterior (BLAKE3 de su JSON canónico).",
      "type": "object",
      "additionalProperties": false,
      "required": ["ts", "task_id", "from", "to", "actor", "reason", "evidence_ref", "prev_hash"],
      "properties": {
        "ts": { "$ref": "../common/v1.json#/$defs/timestamp" },
        "task_id": { "$ref": "../common/v1.json#/$defs/taskId" },
        "from": { "anyOf": [{ "$ref": "#/$defs/state" }, { "type": "null" }] },
        "to": { "$ref": "#/$defs/state" },
        "actor": { "$ref": "#/$defs/actor" },
        "reason": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "evidence_hash": { "$ref": "../common/v1.json#/$defs/hash" },
        "prev_hash": { "anyOf": [{ "$ref": "../common/v1.json#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "change"],
      "properties": {
        "path": { "$ref": "../common/v1.json#/$defs/fileId" },
        "change": { "enum": ["added", "modified", "deleted"] }
      }
    },
    "evidence": {
      "description": ".foker/runs/<task_id>/<attempt>/evidence.json",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "task_id",
        "attempt",
        "foker_version",
        "started_at",
        "finished_at",
        "map_hash",
        "changes",
        "gates",
        "result"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "task_id": { "$ref": "../common/v1.json#/$defs/taskId" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 5 },
        "foker_version": { "$ref": "../common/v1.json#/$defs/semver" },
        "started_at": { "$ref": "../common/v1.json#/$defs/timestamp" },
        "finished_at": { "$ref": "../common/v1.json#/$defs/timestamp" },
        "map_hash": { "$ref": "../common/v1.json#/$defs/hash" },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "gates": { "type": "array", "items": { "$ref": "../common/v1.json#/$defs/gateResult" } },
        "result": { "$ref": "#/$defs/state" }
      }
    }
  }
}
