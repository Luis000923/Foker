{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foker.dev/schemas/benchmark-manifest/v1.json",
  "title": "BenchmarkManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repos",
    "tasks",
    "model",
    "host",
    "foker_version",
    "seeds",
    "limits",
    "prices",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "commit"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "fixture": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repo", "type", "statement", "gold_patch", "hidden_tests", "gold_modified"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": ["fix", "feature", "refactor", "test"]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "gold_patch": {
            "type": "string",
            "minLength": 1
          },
          "hidden_tests": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fail_to_pass", "pass_to_pass"],
            "properties": {
              "fail_to_pass": {
                "type": "object",
                "additionalProperties": false,
                "required": ["paths", "command"],
                "properties": {
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "pass_to_pass": {
                "type": "object",
                "additionalProperties": false,
                "required": ["paths", "command"],
                "properties": {
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "command": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "gold_modified": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gold_read": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "model": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "enum": ["claude-code", "codex"]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foker_version": {
      "$ref": "../common/v1.json#/$defs/semver"
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "order", "bootstrap"],
      "properties": {
        "fixture": {
          "type": "integer",
          "minimum": 0
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "bootstrap": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_turns", "max_minutes", "max_cost_usd"],
      "properties": {
        "max_turns": {
          "const": 60
        },
        "max_minutes": {
          "const": 30
        },
        "max_cost_usd": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0
        }
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "models"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "input", "cache_read", "cache_write", "output"],
            "properties": {
              "model": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "input": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "cache_read": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "cache_write": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "output": {
                "type": ["number", "null"],
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "suites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["smoke", "full"],
      "properties": {
        "smoke": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "full": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
