{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foker.dev/schemas/mcp-tools/v1.json",
  "title": "Herramientas MCP de Foker",
  "description": "Definición de las 8 herramientas del servidor MCP (FOKER-SPEC §10.3), en orden alfabético. inputSchema y outputSchema se publican autocontenidos tras resolver sus $ref.",
  "foker_mcp_api": 1,
  "tools": [
    {
      "name": "foker_check",
      "title": "Ejecutar checks",
      "description": "Feedback intermedio opcional: ejecuta checks del perfil sin cambiar tareas. Requiere trust; submit ya ejecuta checks.",
      "inputSchema": {
        "title": "FokerCheckInput",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "default": "quick"
          },
          "checks": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          },
          "packages": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[@a-z0-9][\\w.\\-/@]*$"
            }
          }
        }
      },
      "outputSchema": {
        "title": "FokerCheckOutput",
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["ok", "results"],
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/mcpCheckResult"
                }
              },
              "diagnostics": {
                "$ref": "#/$defs/diagnostics"
              }
            }
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "timeout_s": 600
    },
    {
      "name": "foker_context",
      "title": "Contexto para una tarea",
      "description": "Pack de reglas, skill, dependencias y código objetivo. Usa anclas conocidas; explain=true añade razones. No releas objetivos salvo aviso de omisión.",
      "inputSchema": {
        "title": "FokerContextInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["task"],
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "anchors": {
            "$ref": "../context-pack/v1.json#/$defs/anchors"
          },
          "intent": {
            "$ref": "../context-pack/v1.json#/$defs/intent"
          },
          "budget_tokens": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 20000
          },
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "task_id": {
            "$ref": "../common/v1.json#/$defs/taskId"
          },
          "dirty_files": {
            "type": "boolean",
            "default": true
          },
          "explain": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "outputSchema": {
        "title": "FokerContextOutput",
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "oneOf": [
              {
                "$ref": "#/$defs/mcpContextPack"
              },
              {
                "$ref": "../context-pack/v1.json"
              }
            ]
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "timeout_s": 30
    },
    {
      "name": "foker_impact",
      "title": "Radio de impacto",
      "description": "Dependientes/dependencias de archivos o símbolos, con paquetes y tests; profundidad ≤3.",
      "inputSchema": {
        "title": "FokerImpactInput",
        "type": "object",
        "additionalProperties": false,
        "anyOf": [
          {
            "required": ["files"]
          },
          {
            "required": ["symbols"]
          }
        ],
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "symbols": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "direction": {
            "enum": ["dependents", "dependencies", "both"],
            "default": "dependents"
          },
          "depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "default": 2
          }
        }
      },
      "outputSchema": {
        "title": "FokerImpactOutput",
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodes", "packages", "tests"],
            "properties": {
              "nodes": {
                "description": "Ordenados por distancia e id.",
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "distance", "via", "kind"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "distance": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "via": {
                      "description": "Tipo de arista por la que se llegó; null para el origen.",
                      "type": ["string", "null"]
                    },
                    "kind": {
                      "enum": ["file", "symbol", "package"]
                    }
                  }
                }
              },
              "packages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tests": {
                "type": "array",
                "items": {
                  "$ref": "../common/v1.json#/$defs/fileId"
                }
              },
              "diagnostics": {
                "$ref": "#/$defs/diagnostics"
              }
            }
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "timeout_s": 10
    },
    {
      "name": "foker_search",
      "title": "Buscar archivos y símbolos",
      "description": "Busca archivos/símbolos por nombre o ruta (BM25). Opcional si el pack no basta.",
      "inputSchema": {
        "title": "FokerSearchInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "enum": ["file", "symbol", "any"],
            "default": "any"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "default": 20
          }
        }
      },
      "outputSchema": {
        "title": "FokerSearchOutput",
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["hits"],
            "properties": {
              "hits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "kind", "name", "file", "score"],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": ["file", "symbol"]
                    },
                    "name": {
                      "type": "string"
                    },
                    "file": {
                      "$ref": "../common/v1.json#/$defs/fileId"
                    },
                    "signature": {
                      "type": "string"
                    },
                    "score": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              },
              "diagnostics": {
                "$ref": "#/$defs/diagnostics"
              }
            }
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "timeout_s": 10
    },
    {
      "name": "foker_status",
      "title": "Estado de Foker",
      "description": "Estado: versiones, mapa/frescura, perfiles, trust y tareas activas.",
      "inputSchema": {
        "title": "FokerStatusInput",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "title": "FokerStatusOutput",
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "foker_version",
              "foker_mcp_api",
              "protocol",
              "root_name",
              "map",
              "profiles",
              "active_tasks",
              "trust"
            ],
            "properties": {
              "foker_version": {
                "$ref": "../common/v1.json#/$defs/semver"
              },
              "foker_mcp_api": {
                "type": "integer",
                "minimum": 1
              },
              "protocol": {
                "description": "Revisión MCP negociada.",
                "type": "string"
              },
              "root_name": {
                "description": "Nombre del directorio raíz (nunca la ruta absoluta).",
                "type": "string"
              },
              "map": {
                "type": "object",
                "additionalProperties": false,
                "required": ["content_hash", "files", "symbols", "stale_files", "schema_version"],
                "properties": {
                  "content_hash": {
                    "$ref": "../common/v1.json#/$defs/hash"
                  },
                  "files": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "symbols": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "stale_files": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "schema_version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "profiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "active_tasks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["task_id", "state"],
                  "properties": {
                    "task_id": {
                      "$ref": "../common/v1.json#/$defs/taskId"
                    },
                    "state": {
                      "$ref": "../task/v1.json#/$defs/state"
                    }
                  }
                }
              },
              "trust": {
                "enum": ["trusted", "untrusted"]
              },
              "diagnostics": {
                "$ref": "#/$defs/diagnostics"
              }
            }
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "timeout_s": 30
    },
    {
      "name": "foker_task_begin",
      "title": "Empezar tarea",
      "description": "Crea tarea y pack con context. Omite scope para derivarlo; un alcance inexistente se rechaza sin tarea. client_token deduplica; conserva task_id si falla el pack final.",
      "inputSchema": {
        "title": "FokerTaskBeginInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "scope": {
            "$ref": "../task/v1.json#/$defs/scope"
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$",
            "default": "default"
          },
          "skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          },
          "max_attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          },
          "client_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "context": {
            "description": "Pack en esta llamada; true usa defaults. Opciones de transporte, no cambian la identidad de la tarea.",
            "oneOf": [
              {
                "const": true
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "budget_tokens": {
                    "type": "integer",
                    "minimum": 1000,
                    "maximum": 20000
                  },
                  "anchors": {
                    "$ref": "../context-pack/v1.json#/$defs/anchors"
                  },
                  "intent": {
                    "$ref": "../context-pack/v1.json#/$defs/intent"
                  }
                }
              }
            ]
          }
        },
        "if": {
          "not": {
            "required": ["scope"]
          }
        },
        "then": {
          "required": ["context"]
        }
      },
      "outputSchema": {
        "title": "FokerTaskBeginOutput",
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "state",
              "attempt",
              "baseline",
              "allowed_paths",
              "protected_paths_in_scope",
              "checks"
            ],
            "properties": {
              "task_id": {
                "$ref": "../common/v1.json#/$defs/taskId"
              },
              "state": {
                "const": "RUNNING"
              },
              "attempt": {
                "const": 1
              },
              "baseline": {
                "$ref": "#/$defs/mcpBaseline"
              },
              "allowed_paths": {
                "type": "array",
                "items": {
                  "$ref": "../common/v1.json#/$defs/glob"
                }
              },
              "protected_paths_in_scope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "diagnostics": {
                "$ref": "#/$defs/diagnostics"
              },
              "context": {
                "$ref": "#/$defs/mcpTaskContext"
              },
              "context_error": {
                "description": "La tarea existe; el pack falló. Recupera contexto con task_id.",
                "type": "object",
                "additionalProperties": false,
                "required": ["code", "message", "recoverable"],
                "properties": {
                  "code": {
                    "$ref": "../common/v1.json#/$defs/errorCode"
                  },
                  "message": {
                    "type": "string"
                  },
                  "recoverable": {
                    "type": "boolean"
                  }
                }
              },
              "scope_derived": {
                "description": "La llamada omitió scope; allowed_paths contiene el alcance derivado o reutilizado de la tarea.",
                "type": "boolean"
              }
            },
            "not": {
              "required": ["context", "context_error"]
            }
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "timeout_s": 30
    },
    {
      "name": "foker_task_get",
      "title": "Consultar tarea",
      "description": "Lee estado, intentos, hallazgos y siguiente acción de task_id.",
      "inputSchema": {
        "title": "FokerTaskGetInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id"],
        "properties": {
          "task_id": {
            "$ref": "../common/v1.json#/$defs/taskId"
          }
        }
      },
      "outputSchema": {
        "title": "FokerTaskGetOutput",
        "type": "object",
        "anyOf": [
          {
            "$ref": "../task/v1.json"
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "timeout_s": 5
    },
    {
      "name": "foker_task_cancel",
      "title": "Cancelar tarea",
      "description": "Abandona una tarea no terminal (RUNNING, BLOCKED…) y libera el hook de parada. Devuelve la tarea CANCELLED.",
      "inputSchema": {
        "title": "FokerTaskCancelInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id"],
        "properties": {
          "task_id": {
            "$ref": "../common/v1.json#/$defs/taskId"
          }
        }
      },
      "outputSchema": {
        "title": "FokerTaskCancelOutput",
        "type": "object",
        "anyOf": [
          {
            "$ref": "../task/v1.json"
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "timeout_s": 5
    },
    {
      "name": "foker_task_submit",
      "title": "Enviar tarea a validación",
      "description": "Ejecuta checks y gates del intento. Solo COMPLETED termina; REJECTED: corrige y reenvía; AWAITING_APPROVAL/BLOCKED: informa al humano. Consume un intento.",
      "inputSchema": {
        "title": "FokerTaskSubmitInput",
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id"],
        "properties": {
          "task_id": {
            "$ref": "../common/v1.json#/$defs/taskId"
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "outputSchema": {
        "title": "FokerTaskSubmitOutput",
        "type": "object",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "state", "attempt", "gates", "evidence", "next_action"],
            "properties": {
              "task_id": {
                "$ref": "../common/v1.json#/$defs/taskId"
              },
              "state": {
                "$ref": "../task/v1.json#/$defs/state"
              },
              "attempt": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "gates": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/mcpGateResult"
                }
              },
              "evidence": {
                "description": "Ruta relativa al root del evidence.json.",
                "type": "string",
                "pattern": "^\\.foker/runs/tsk_[0-9A-HJKMNP-TV-Z]{26}/[1-5]/evidence(\\.[0-9]+)?\\.json$"
              },
              "next_action": {
                "enum": ["done", "fix_and_resubmit", "await_human_approval", "blocked_contact_human", "failed"]
              },
              "diagnostics": {
                "$ref": "#/$defs/diagnostics"
              }
            }
          },
          {
            "$ref": "#/$defs/mcpToolError"
          }
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "timeout_s": 600
    }
  ],
  "$defs": {
    "diagnostics": {
      "description": "Avisos no fatales, p. ej. salida truncada a 80.000 caracteres (FOKER-SPEC §10.5).",
      "type": "array",
      "items": {
        "$ref": "../common/v1.json#/$defs/diagnostic"
      }
    },
    "mcpBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_head", "dirty_files", "snapshot_hash"],
      "properties": {
        "git_head": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "dirty_files": {
          "type": "array",
          "items": {
            "$ref": "../common/v1.json#/$defs/fileId"
          }
        },
        "snapshot_hash": {
          "description": "Hash de los hashes de archivos en alcance al empezar.",
          "$ref": "../common/v1.json#/$defs/hash"
        },
        "dirty_files_total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total original, incluidas rutas bajo node_modules."
        },
        "dirty_files_truncated": {
          "type": "boolean",
          "description": "La lista mostrada omite rutas del baseline original."
        }
      }
    },
    "mcpCheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "status", "exit_code", "duration_ms", "findings"],
      "properties": {
        "check": {
          "type": "string"
        },
        "status": {
          "enum": ["pass", "fail", "timeout", "skipped"]
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "../common/v1.json#/$defs/finding"
          }
        },
        "output_tail": {
          "description": "Salida sin ANSI; solo se devuelve para checks que no pasan.",
          "type": "string"
        }
      }
    },
    "mcpGateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "findings"],
      "properties": {
        "gate": {
          "description": "G1 scope, G2 policy, G3 map, G4 checks, G5 skill (FOKER-SPEC §12.4).",
          "enum": ["scope", "policy", "map", "checks", "skill"]
        },
        "status": {
          "enum": ["pass", "fail", "blocked", "approval_required", "skipped"]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "../common/v1.json#/$defs/finding"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mcpCheckResult"
          }
        }
      }
    },
    "mcpContextBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "limit"],
      "properties": {
        "used": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mcpTaskContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_hash", "budget", "rendered"],
      "properties": {
        "pack_hash": {
          "$ref": "../common/v1.json#/$defs/hash"
        },
        "budget": {
          "$ref": "#/$defs/mcpContextBudget"
        },
        "rendered": {
          "type": "string"
        }
      }
    },
    "mcpContextPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pack_version", "pack_hash", "budget", "rendered", "diagnostics"],
      "properties": {
        "pack_version": {
          "enum": [1, 2]
        },
        "pack_hash": {
          "$ref": "../common/v1.json#/$defs/hash"
        },
        "budget": {
          "$ref": "#/$defs/mcpContextBudget"
        },
        "rendered": {
          "type": "string"
        },
        "diagnostics": {
