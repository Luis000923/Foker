{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foker.dev/schemas/foker-md/v1.json",
  "title": "Frontmatter de foker.md",
  "description": "Frontmatter YAML de la especificación de producto (FOKER-SPEC §15.1). El cuerpo Markdown es libre y no confiable (T1).",
  "type": "object",
  "additionalProperties": false,
  "required": ["foker_spec", "name"],
  "properties": {
    "foker_spec": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 214
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "options": {
          "type": "object"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "description": "Arquitectura declarada; `foker skill install` resuelve las skills a partir de ella.",
      "properties": {
        "stack": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "orm": {
          "enum": ["drizzle", "prisma", "none"]
        },
        "auth": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9.]+)*$",
          "maxLength": 64
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "owasp_asvs": {
              "enum": ["L1", "L2", "L3"]
            }
          }
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "description": "Preset de Design Tokens estáticos con el que `foker init` hidrata la plantilla.",
      "properties": {
        "preset": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        }
      }
    },
    "design_system": {
      "type": "object",
      "additionalProperties": false,
      "description": "Contrato estático compatible con paquetes open-design; no carga contenido remoto ni inicia procesos.",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "preset": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "format": { "const": "open-design/v1" },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["DESIGN.md", "manifest.json", "tokens.css"] },
          "allOf": [
            { "contains": { "const": "DESIGN.md" } },
            { "contains": { "const": "manifest.json" } },
            { "contains": { "const": "tokens.css" } }
          ]
        }
      }
    }
  }
}
