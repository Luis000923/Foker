{
  "name": "@foker/schemas",
  "version": "0.1.1",
  "description": "JSON Schemas and contracts for Foker: generated TypeScript types and validators.",
  "license": "Apache-2.0",
  "author": "Luis (@Luis000923)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luis000923/Foker.git",
    "directory": "packages/schemas"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "@foker/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "data"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0",
    "yaml": "2.9.1"
  }
}
