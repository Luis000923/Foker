{
  "schema_version": 1,
  "name": "neutral",
  "typography": {
    "font_sans": "system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "font_mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem"
    },
    "line_height": {
      "tight": 1.25,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },
  "colors": {
    "light": {
      "background": "#ffffff",
      "foreground": "#111827",
      "primary": "#2563eb",
      "primary_foreground": "#ffffff",
      "muted": "#f3f4f6",
      "muted_foreground": "#4b5563",
      "border": "#e5e7eb",
      "danger": "#b91c1c"
    },
    "dark": {
      "background": "#0b0f19",
      "foreground": "#f3f4f6",
      "primary": "#60a5fa",
      "primary_foreground": "#0b0f19",
      "muted": "#1f2937",
      "muted_foreground": "#9ca3af",
      "border": "#374151",
      "danger": "#f87171"
    }
  },
  "spacing": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem"
  }
}
