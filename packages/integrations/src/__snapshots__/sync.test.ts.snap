  "opencode.json": "{
  "mcp": {
    "foker": {
      "type": "local",
      "command": [
        "npx",
        "--no-install",
        "foker",
        "mcp",
        "--root",
        "."
      ],
      "enabled": true,
      "timeout": 600000
    }
  },
  "permission": {
    "edit": {
      ".foker/**": "deny",
      "foker.config.yaml": "deny"
    },
    "read": {
      ".env": "deny",
      "**/*.pem": "deny"
    },
    "bash": {
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean *": "deny",
      "git checkout -- .": "deny"
    }
  }
}
",
}
`;
