{
  "name": "@foker/integrations",
  "version": "0.1.2",
  "description": "Foker integrations: config generators for Claude Code, OpenCode, Antigravity, and Codex, plus upstream skill and design-token integrations.",
  "license": "Apache-2.0",
  "author": "Luis (@Luis000923)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luis000923/Foker.git",
    "directory": "packages/integrations"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "@foker/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "roles"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node ../../scripts/copy-data.mjs roles packages/integrations/roles && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@foker/schemas": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
