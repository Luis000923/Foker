{
  "name": "@foker/integrations",
  "version": "0.0.0",
  "description": "Generadores de configuración para Claude Code, OpenCode, Antigravity y Codex.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "@foker/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "roles"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node ../../scripts/copy-data.mjs roles packages/integrations/roles && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@foker/schemas": "workspace:*",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
