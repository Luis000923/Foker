{
  "name": "@foker/core",
  "version": "0.1.2",
  "description": "Foker native core: Rust AST context engine and PageRank bindings (napi-rs) for macOS, Linux (glibc) and Windows x64.",
  "license": "Apache-2.0",
  "author": "Luis (@Luis000923)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luis000923/Foker.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "@foker/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "binding.cjs",
    "binding.d.cts"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "napi build --platform --release --manifest-path ../../crates/foker-napi/Cargo.toml --output-dir . --js binding.cjs --dts binding.d.cts --js-package-name @foker/core"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.6"
  },
  "napi": {
    "binaryName": "foker-core",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  }
}
