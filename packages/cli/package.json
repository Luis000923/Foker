{
  "name": "foker",
  "version": "0.0.0",
  "description": "CLI de Foker.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "@foker/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node ../../scripts/copy-data.mjs templates packages/cli/templates && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@foker/engine": "workspace:*",
    "@foker/integrations": "workspace:*",
    "@foker/mcp": "workspace:*",
    "@foker/core": "workspace:*",
    "@foker/schemas": "workspace:*",
    "yaml": "2.9.1"
  },
  "bin": {
    "foker": "./dist/bin.js"
  }
}
