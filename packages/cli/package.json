{
  "name": "@foker/cli",
  "version": "0.1.1",
  "description": "Foker CLI: deterministic infrastructure for AI agents working on TypeScript monorepos.",
  "license": "Apache-2.0",
  "author": "Luis (@Luis000923)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luis000923/Foker.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "type": "module",
  "exports": {
    ".": {
      "@foker/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node ../../scripts/copy-data.mjs templates packages/cli/templates && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@foker/engine": "workspace:*",
    "@foker/integrations": "workspace:*",
    "@foker/mcp": "workspace:*",
    "@foker/core": "workspace:*",
    "@foker/schemas": "workspace:*",
    "yaml": "2.9.1"
  },
  "bin": {
    "foker": "./dist/bin.js"
  }
}
